# --- FalkorDB ---
# EMBEDDED (default): uses falkordblite, no server needed.
# EXTERNAL: set FALKOR_HOST to use a real FalkorDB server (e.g. FalkorDB Cloud).
# FALKOR_HOST=localhost
# FALKOR_PORT=6379
# FALKOR_PASSWORD=

# --- LLM provider ---
# heuristic (default): free, offline, pattern-based. Every reply is labeled.
# auto: real free AI — uses GROQ_API_KEY first, then GEMINI_API_KEY.
#       Falls back honestly to heuristic when no key / on any error.
# groq / gemini: force one provider.
LLM_PROVIDER=heuristic
# --- Free LLM keys (see LLM_SETUP.md — 5 min setup, NO credit card) ---
# Groq: https://console.groq.com -> API Keys -> Create (free tier, no card)
# GROQ_API_KEY=
# Optional: GROQ_MODEL=llama-3.3-70b-versatile
# Backup — Google AI Studio: https://aistudio.google.com -> Get API Key (free, no card)
# GEMINI_API_KEY=
